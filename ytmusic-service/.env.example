# Token bebas, wajib sama dengan yang diisi di aplikasi Nao MD
API_TOKEN=ganti-dengan-token-rahasia-anda

# Kredensial akun YouTube Music untuk ytmusicapi (pilih salah satu)
YTMUSIC_AUTH_FILE=/data/auth.json
# YTMUSIC_AUTH_JSON={"...":"isi auth.json dalam satu baris"}

# Cookie akun untuk yt-dlp (agar pemutaran tanpa iklan / kualitas premium)
COOKIES_FILE=/data/cookies.txt
